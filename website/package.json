    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "dev": "vite",
        "build": "tsc && vite build",
        "test": "tsc && TZ=1Z vitest run",
        "lint": "eslint . --max-warnings 0",
