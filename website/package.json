        "file-saver": "^2.0.5",
        "geo-distance-helper": "^2.0.4",
        "gpx-builder": "^6.0.0",
        "jszip": "^3.10.2",
        "leaflet": "^1.9.4",
        "leaflet.locatecontrol": "^0.90.1",
        "lz-string": "^1.5.0",
        "react": "19.2.4",
        "react-bootstrap": "^2.10.10",
        "react-colorful": "^5.6.1",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.2.4",
        "react-drag-drop-files": "^3.1.0",
        "react-intl": "^12.1.6",
        "react-redux": "^9.3.1",
