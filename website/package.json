        "globals": "^17.14.0",
        "husky": "^4.3.7",
        "jsdom": "^29.0.1",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "vite": "7.3.1",
        "vitest": "^4.1.0"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": "prettier --write"
